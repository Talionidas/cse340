<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <p><%= project.description %></p>
    <p>Date: <%= new Date(project.date).toLocaleDateString('en-US') %></p>
    <p>Location: <%= project.location %></p>

    <h2>Partner Organization</h2>
    <p>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <h2>Categories</h2>
    <% if (categories.length > 0) { %>
        <ul class="category-tags">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <p><a href="/projects">Back to Upcoming Projects</a></p>
</main>

<%- include('partials/footer') %>
