<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Explore our upcoming service projects and find opportunities to help your community.</p>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <%= new Date(project.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) %>:
                <%= project.title %> (<em><%= project.organization_name %></em>)
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>

