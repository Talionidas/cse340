<%- include('partials/header') %>

<main>
    <h1><%= organization.name %></h1>

    <img
        src="/images/<%= organization.logo_filename %>"
        alt="<%= organization.name %> logo"
        width="200"
    >

    <p><%= organization.description %></p>

    <p>
        Contact:
        <a href="mailto:<%= organization.contact_email %>">
            <%= organization.contact_email %>
        </a>
    </p>

    <p>
        <a href="/edit-organization/<%= organization.organization_id %>">
            Edit Organization
        </a>
    </p>

    <h2>Service Projects</h2>

    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                    <% if (project.date) { %>
                        - <%= new Date(project.date).toLocaleDateString('en-US') %>
                    <% } %>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects are available for this organization.</p>
    <% } %>

    <p><a href="/organizations">Back to Organizations</a></p>
</main>

<%- include('partials/footer') %>
