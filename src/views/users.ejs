<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>View all registered users and their assigned roles.</p>

    <p>Total registered users: <%= users.length %></p>

    <% if (users.length > 0) { %>
        <div class="table-container">
            <table class="users-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email (Username)</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(registeredUser => { %>
                        <tr>
                            <td><%= registeredUser.name %></td>
                            <td><%= registeredUser.email %></td>
                            <td><%= registeredUser.role_name || 'Unassigned' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <p>No registered users are currently available.</p>
    <% } %>

    <p><a href="/dashboard">Back to Dashboard</a></p>
</main>

<%- include('partials/footer') %>